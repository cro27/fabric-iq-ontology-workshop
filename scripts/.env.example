# Azure Event Hubs - copy to `.env` and fill in real values.
# Both producers use this namespace and authenticate with Entra ID.
EVENT_HUB_FULLY_QUALIFIED_NAMESPACE="<name>.servicebus.windows.net"

# Each producer reads its own hub name from this shared file.
EH_NAME_FRIDGE="kw-fridge-telemetry"
EH_NAME_TRUCK="kw-truck-telemetry"

# Truck only: how often to publish, in seconds (default 1800).
EH_INTERVAL_SECONDS=1800

# Truck only: interval divisor. Try 60 for a 30-second send interval.
EH_SPEEDUP=1
